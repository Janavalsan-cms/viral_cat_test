<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ================= STATIC BLOG PAGES =================

# Prevent ANY rewriting of these files
RewriteRule ^blogs\.html$ - [L]
RewriteRule ^blog-detail\.html$ - [L]

# /blogs → blogs.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blogs/?$ blogs.html [L,NC]

# /blog-detail/slug → blog-detail.html?slug=
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog-detail/([^/]+)/?$ blog-detail.html?slug=$1 [L,QSA,NC]


# ================= WORDPRESS IN /blog =================

RewriteRule ^blog/index\.php$ - [L]

RewriteCond %{REQUEST_URI} ^/blog/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/ /blog/index.php [L]


# ================= GENERAL CLEAN URL =================

# www → non-www
RewriteCond %{HTTP_HOST} ^www\.viralcatmeow\.com$ [NC]
RewriteRule ^(.*)$ https://viralcatmeow.com/$1 [R=301,L]

# index.html → /
RewriteCond %{THE_REQUEST} /index\.html
RewriteRule ^index\.html$ / [R=301,L]

# .html → clean (skip blog)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteCond %{REQUEST_URI} !^/blog/
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# serve clean URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteCond %{REQUEST_URI} !^/blog/
RewriteRule ^([^/]+)/?$ $1.html [L]

# careers
RewriteRule ^careers/?$ career.html [L]

</IfModule>