<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ====================
# 1. WWW → NON-WWW (always first)
# ====================
RewriteCond %{HTTP_HOST} ^www\.viralcatmeow\.com$ [NC]
RewriteRule ^(.*)$ https://viralcatmeow.com/$1 [R=301,L]

# ====================
# 2. PROTECT STATIC HTML FILES (serve as-is, no rewriting)
# ====================
RewriteCond %{REQUEST_URI} ^/blogs\.html$ [OR]
RewriteCond %{REQUEST_URI} ^/blog-detail\.html$
RewriteRule ^ - [L]

# ====================
# 3. BLOG CLEAN URLS
# ====================

# /blogs → /blogs.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blogs/?$ /blogs.html [L,NC]

# /blog-detail/slug → /blog-detail.html?slug=slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog-detail/([^/]+)/?$ /blog-detail.html?slug=$1 [L,QSA,NC]

# ====================
# 4. WORDPRESS /blog DIRECTORY
# ====================

# Don't touch blog/index.php
RewriteRule ^blog/index\.php$ - [L]

# If /blog/some-slug maps to /some-slug.html in root, redirect to clean URL
RewriteCond %{REQUEST_URI} ^/blog/(.+)$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^blog/(.+)/?$ /$1 [R=301,L]

# WordPress: pass everything else under /blog/ to WordPress index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(blog/.*)$ /blog/index.php [L]

# ====================
# 5. GENERAL SITE RULES
# ====================

# /index.html → /
RewriteCond %{THE_REQUEST} /index\.html
RewriteRule ^index\.html$ / [R=301,L]

# Redirect .html → clean URLs (skip blogs.html, blog-detail.html, /blog/)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteCond %{REQUEST_URI} !^/blogs\.html$
RewriteCond %{REQUEST_URI} !^/blog-detail\.html$
RewriteCond %{REQUEST_URI} !^/blog/ [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# Serve clean URLs internally (skip /blogs, /blog-detail/, /blog/)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteCond %{REQUEST_URI} !^/blogs/?$
RewriteCond %{REQUEST_URI} !^/blog-detail/
RewriteCond %{REQUEST_URI} !^/blog/ [NC]
RewriteRule ^([^/]+)/?$ $1.html [L]

# /careers → /career.html
RewriteRule ^careers/?$ /career.html [L]

</IfModule>